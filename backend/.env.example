# Application
NODE_ENV=development
PORT=3000
DEBATE_CHAT_WS_PORT=8080
DEBATE_TURN_MAX_CONTENT_LENGTH=500

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/heimdall_db

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Gemini
GEMINI_API_KEY=
GEMINI_ANALYZER_MODEL=gemini-3.6-flash
GEMINI_FACT_CHECKER_MODEL=gemini-3.6-flash
GEMINI_JUDGE_MODEL=gemini-3.6-flash
GEMINI_ANALYZER_THINKING_LEVEL=MEDIUM
GEMINI_FACT_CHECK_GROUNDING_THINKING_LEVEL=LOW
GEMINI_FACT_CHECK_SYNTHESIS_THINKING_LEVEL=LOW
GEMINI_JUDGE_THINKING_LEVEL=MEDIUM
GEMINI_REQUEST_TIMEOUT_MS=90000
GEMINI_ANALYZER_TIMEOUT_MS=70000
GEMINI_FACT_CHECK_GROUNDING_TIMEOUT_MS=90000
GEMINI_FACT_CHECK_SYNTHESIS_TIMEOUT_MS=70000
GEMINI_JUDGE_TIMEOUT_MS=40000
# Analyzer limits
ANALYZER_MAX_COMPONENTS_PER_TURN=10
ANALYZER_MAX_FACT_CHECK_TARGETS_PER_TURN=5
ANALYZER_MAX_COMPONENT_STATEMENT_LENGTH=1000
ANALYZER_RECOVERY_INTERVAL_MS=30000
ANALYZER_PROCESSING_STALE_MS=80000

# Fact checker limits
FACT_CHECK_MAX_TARGETS_PER_BATCH=10
FACT_CHECK_MAX_REASON_LENGTH=2000
FACT_CHECK_MAX_SOURCES_PER_GROUNDING=5
FACT_CHECK_MAX_SOURCES_PER_RESULT=5
FACT_CHECK_ENABLED=true
FACT_CHECK_RECOVERY_INTERVAL_MS=30000
FACT_CHECK_PROCESSING_STALE_MS=200000

# Judge limits
JUDGE_MAX_OVERALL_REASON_LENGTH=3000
JUDGE_MAX_FEEDBACK_LENGTH=1500
JUDGE_RECOVERY_INTERVAL_MS=30000
JUDGE_PROCESSING_STALE_MS=75000
JUDGE_MANUAL_RETRY_STALE_MS=75000
