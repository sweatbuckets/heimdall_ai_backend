# Application
NODE_ENV=development
PORT=3000
DEBATE_CHAT_WS_PORT=8080

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/heimdall_db

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Gemini
GEMINI_API_KEY=
GEMINI_ANALYZER_MODEL=gemini-3.5-flash
GEMINI_FACT_CHECKER_MODEL=gemini-3.5-flash
GEMINI_JUDGE_MODEL=gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_MS=120000
GEMINI_ANALYZER_MAX_RETRIES=0
GEMINI_FACT_CHECKER_MAX_RETRIES=1
GEMINI_JUDGE_MAX_RETRIES=3

# Analyzer limits
ANALYZER_MAX_COMPONENTS_PER_TURN=10
ANALYZER_MAX_FACT_CHECK_TARGETS_PER_TURN=5
ANALYZER_MAX_COMPONENT_STATEMENT_LENGTH=1000
ANALYZER_RECOVERY_INTERVAL_MS=60000
ANALYZER_PROCESSING_STALE_MS=600000

# Fact checker limits
FACT_CHECK_MAX_TARGETS_PER_BATCH=5
FACT_CHECK_MAX_REASON_LENGTH=2000
FACT_CHECK_MAX_SOURCES_PER_RESULT=5
FACT_CHECK_ENABLED=true
FACT_CHECK_RECOVERY_INTERVAL_MS=60000
FACT_CHECK_PROCESSING_STALE_MS=600000

# Judge limits
JUDGE_MAX_OVERALL_REASON_LENGTH=3000
JUDGE_MAX_FEEDBACK_LENGTH=1500
JUDGE_PROCESSING_STALE_MS=300000
